    {
      "id": 13,
      "type": "timeseries",
      "title": "Inference: p50 / p95 / p99",
      "description": "histogram_quantile по сумме бакетов всех выбранных воркеров (перцентили нельзя усреднять — складываем бакеты). Ромбики — exemplars: клик открывает трейс конкретной задачи.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(worker_inference_duration_seconds_bucket{job=\"worker\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "inference p50",
          "refId": "A",
          "range": true,
          "instant": false,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(worker_inference_duration_seconds_bucket{job=\"worker\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "inference p95",
          "refId": "B",
          "range": true,
          "instant": false,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(worker_inference_duration_seconds_bucket{job=\"worker\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "inference p99",
          "refId": "C",
          "range": true,
          "instant": false,
          "exemplar": true
        }
      ]
