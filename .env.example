# Скопировать в .env и поправить при необходимости
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HEALTH_CHECK_TIMEOUT=3.0

# Локальный запуск через uv (Postgres из compose опубликован на 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mlops_phishing

# Для docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlops_phishing
