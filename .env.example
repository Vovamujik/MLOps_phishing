ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HEALTH_CHECK_TIMEOUT=3.0

# Модель из MLflow Model Registry (грузит воркер): какая версия стоит за alias, решает реестр
MODEL_NAME=phishing-url-clf
MODEL_ALIAS=champion
PHISHING_THRESHOLD=0.5

# Локальный запуск через uv (Postgres из compose опубликован на 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mlops_phishing

# Для docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlops_phishing

# MLflow в docker compose: UI на http://localhost:5050, консоль хранилища на http://localhost:9001
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow
S3_ACCESS_KEY=mlflow
S3_SECRET_KEY=mlflow-secret

# Скрипты обучения и локальный запуск воркера через uv (в compose у worker свой адрес)
MLFLOW_TRACKING_URI=http://localhost:5050
# Иначе клиент скачивает файлы напрямую с s3:9000, а этот адрес виден только внутри compose
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false

# RabbitMQ: Management UI на http://localhost:15672 (логин и пароль ниже)
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_ERLANG_COOKIE=mlops-phishing
# Локальный запуск через uv; в compose у сервисов свой адрес rabbitmq:5672
RABBITMQ_URL=amqp://app:app@localhost:5672/
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# Лимит очереди задач и число повторных доставок до DLQ (применяет rabbitmq-init)
TASKS_QUEUE_MAX_LENGTH=100
TASKS_DELIVERY_LIMIT=3
# Сколько API ждёт брокер, прежде чем ответить 503, секунды
PUBLISH_TIMEOUT=2

# Воркер: потоки inference, prefetch (= потокам; 0 — без ограничения, только для эксперимента),
# добавочное время inference и сколько ждать задачи в работе при остановке
WORKER_POOL_SIZE=4
WORKER_PREFETCH=4
INFERENCE_DELAY_SECONDS=0.2
WORKER_GRACEFUL_TIMEOUT=30

# Источник: пауза после отказа брокера (очередь полна) — первая и потолок, секунды
SOURCE_BACKOFF_INITIAL=0.05
SOURCE_BACKOFF_MAX=1.0

# Телеметрия (OpenTelemetry SDK). Адресов в коде нет — только эти переменные.
# true — SDK не создаёт ни трейсов, ни метрик (dev без стека наблюдаемости)
OTEL_SDK_DISABLED=false
# Collector внутри compose; при локальном запуске через uv Collector недоступен — ставьте OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# service.instance.id не задаём: код берёт hostname контейнера, так различаются реплики воркера
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# Стенд: все трейсы (ratio 1.0). Прод на сотни задач/с: parentbased_traceidratio с 0.01–0.1
# или tail-sampling в Collector, чтобы сохранить все трейсы с ошибками
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Интервал экспорта метрик, мс (= scrape_interval Prometheus)
OTEL_METRIC_EXPORT_INTERVAL=5000

# Стек наблюдаемости: docker compose --profile observability up -d
# Grafana на http://localhost:3000 (без логина — просмотр, admin — правка), Prometheus на http://localhost:9090
# Пароль стенда, не секрет; для общего стенда задайте свой
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Версии образов (закреплены, без latest)
GRAFANA_VERSION=13.2.5
LOKI_VERSION=3.7.9
TEMPO_VERSION=2.10.10
PROMETHEUS_VERSION=v3.15.1
ALLOY_VERSION=v1.21.3
OTEL_COLLECTOR_VERSION=0.164.0
BUSYBOX_VERSION=1.37.0-musl
